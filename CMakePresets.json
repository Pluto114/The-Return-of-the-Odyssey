{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 31, "patch": 0 },
  "configurePresets": [
    {
      "name": "scaffold",
      "displayName": "Validate repository scaffold (no client dependencies)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/scaffold",
      "cacheVariables": { "ODYSSEY_CLIENT_DEPS": "OFF" }
    },
    {
      "name": "client-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VCPKG_MANIFEST_DIR": "${sourceDir}/client",
        "ODYSSEY_CLIENT_DEPS": "ON"
      }
    },
    {
      "name": "client-windows",
      "inherits": "client-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "client-linux",
      "inherits": "client-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x64-linux", "VCPKG_HOST_TRIPLET": "x64-linux" }
    }
  ],
  "buildPresets": [
    { "name": "scaffold", "configurePreset": "scaffold" },
    { "name": "client-windows", "configurePreset": "client-windows", "jobs": 4 },
    { "name": "client-linux", "configurePreset": "client-linux", "jobs": 4 }
  ]
}
