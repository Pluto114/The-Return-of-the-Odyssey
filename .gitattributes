* text=auto eol=lf
*.md whitespace=-blank-at-eol
*.bat text eol=crlf
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.ogg binary
*.wav binary
*.glb binary

# Vendored third-party sources are kept byte-identical to upstream: no line-ending
# normalisation, no whitespace fixups, so a re-vendor stays a clean copy and the
# recorded blob hashes in client/third_party/rlImGui/VENDORED.md keep matching.
client/third_party/** -text
