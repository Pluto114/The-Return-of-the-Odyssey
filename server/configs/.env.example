# Runtime configuration loaded by cmd/gameserver.
ODYSSEY_ENV=development
ODYSSEY_TCP_ADDR=127.0.0.1:7777
ODYSSEY_ADMIN_ADDR=127.0.0.1:8080
ODYSSEY_METRICS_ADDR=0.0.0.0:19091
ODYSSEY_PPROF_ADDR=127.0.0.1:6060
ODYSSEY_TICK_HZ=30
ODYSSEY_SNAPSHOT_HZ=10
ODYSSEY_AI_HZ=10
ODYSSEY_LOG_LEVEL=debug
ODYSSEY_MYSQL_DSN=odyssey:odyssey_local_only@tcp(127.0.0.1:3306)/odyssey?parseTime=true&charset=utf8mb4&loc=UTC
ODYSSEY_REDIS_ADDR=127.0.0.1:6379
ODYSSEY_REDIS_PASSWORD=odyssey_redis_local_only
ODYSSEY_REDIS_DB=0
# A4 合入前开发环境可保持 false；production 必须为 true。
ODYSSEY_RESUME_ENABLED=false
ODYSSEY_RESUME_TTL_SEC=30
ODYSSEY_REDIS_OPERATION_TIMEOUT_MS=2000
# A 的终局路由接线前开发环境可保持 false；production 必须为 true。
ODYSSEY_RESULTS_ENABLED=false
ODYSSEY_RESULT_QUEUE_CAPACITY=256
ODYSSEY_RESULT_MAX_ATTEMPTS=3
ODYSSEY_RESULT_ATTEMPT_TIMEOUT_MS=2000
ODYSSEY_RESULT_RETRY_BACKOFF_MS=100
ODYSSEY_RESULT_SHUTDOWN_TIMEOUT_SEC=5
ODYSSEY_RESULT_DEAD_LETTER_PATH=var/odyssey/result-dead-letter.jsonl
ODYSSEY_EQUIPMENT_CATALOG=data/equipment/catalog.json
ODYSSEY_REWARD_DURATION_SEC=10
ODYSSEY_STAGE_LIMIT=3
ODYSSEY_FIRST_STAGE_SEED_BASE=1
ODYSSEY_DIRECTOR_MIN_DIFFICULTY=0.5
ODYSSEY_DIRECTOR_MAX_DIFFICULTY=10
ODYSSEY_DIRECTOR_TARGET_CLEAR_TIME_SEC=45
ODYSSEY_DIRECTOR_TARGET_DPS=30
ODYSSEY_DIRECTOR_TARGET_DAMAGE_TAKEN=50
